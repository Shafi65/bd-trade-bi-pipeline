# Copy this file to ".env" and fill in your real values.
# The real ".env" is git-ignored and must NEVER be committed.
#
# Get your key at https://comtradedeveloper.un.org/ (free "comtrade - v1" tier).
COMTRADE_API_KEY=your_primary_key_here

# AWS region we'll use (set on Day 1). us-east-1 chosen for widest free-tier + service coverage.
AWS_REGION=us-east-1

# S3 bucket holding processed/ Parquet + athena-results/ (scripts/athena_run.py)
ATHENA_BUCKET=your-bucket-name
# Athena workgroup with a query-result location set (e.g. s3://<bucket>/athena-results/)
ATHENA_WORKGROUP=your-workgroup
# QuickSight username that owns the datasets (scripts/quicksight_setup.py); defaults to the account ID
QS_USER=your-quicksight-username
